# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://betagent:password@localhost:5432/betagent

# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=              # From @BotFather
ALLOWED_TELEGRAM_IDS=            # Comma-separated user IDs: 123456,789012
TELEGRAM_GROUP_ID=               # Syndicate group chat ID (negative, e.g. -5232100830)

# ── LLM Providers (Tier 1 chain: Codex → OpenRouter → Gemini) ───────
OPENCLAW_OAUTH_TOKEN=            # Priority 1: Codex (or auto from ~/.codex/auth.json)
OPENROUTER_API_KEY=              # Priority 2: OpenRouter (https://openrouter.ai/keys)
OPENROUTER_MODEL=                # Optional: override model (default: openrouter/hunter-alpha)
GEMINI_API_KEY=                  # Priority 3: Google Gemini (free tier)
OLLAMA_BASE_URL=http://localhost:11434  # Tier 2 local models

# ── Sports Data APIs (Scout Agent) ──────────────────────────────────
THE_ODDS_API_KEY=               # Odds across all sports (500 req/mo free)
API_SPORTS_KEY=                 # Injuries, standings, fixtures (100 req/day free)

# ── News Search (Devil's Advocate veto engine) ──────────────────────
# Reddit RSS is always available (no key needed), just set your username:
REDDIT_USERNAME=                 # Your Reddit username (for User-Agent header)
# Optional: OAuth for full-text search (supplements RSS feeds)
REDDIT_CLIENT_ID=                # Optional: Reddit app client ID
REDDIT_CLIENT_SECRET=            # Optional: Reddit app client secret
TAVILY_API_KEY=                  # Priority 2: 1000 req/month free
BRAVE_SEARCH_API_KEY=            # Priority 3: 2000 req/month free

# ── Cloudflare Browser Rendering (daily stats crawl) ─────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
